<span font='Iosevka Nerd Font 10' foreground='#ebdbb2'><big><b>SwayWM Keybindings</b></big></span>

<span font='Iosevka Nerd Font 9' foreground='#b8bb26'><b>Basics</b></span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Return</span><span foreground='#ffffff'> - Open terminal</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + d</span><span foreground='#ffffff'> - Open app launcher (dmenu/wmenu)</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Shift + q</span><span foreground='#ffffff'> - Kill/close focused window</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Shift + c</span><span foreground='#ffffff'> - Reload Sway config</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Shift + e</span><span foreground='#ffffff'> - Exit Sway (logout)</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Shift + r</span><span foreground='#ffffff'> - Restart Sway in place</span>

<span font='Iosevka Nerd Font 9' foreground='#b8bb26'><b>Focus / Navigation</b></span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + $left / $down / $up / $right</span><span foreground='#ffffff'> - Move focus left/down/up/right</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + j/k/l/;</span><span foreground='#ffffff'> - Move focus left/down/up/right (vim-style)</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + a</span><span foreground='#ffffff'> - Focus parent container</span>

<span font='Iosevka Nerd Font 9' foreground='#b8bb26'><b>Moving Windows</b></span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Shift + $left / $down / $up / $right</span><span foreground='#ffffff'> - Move focused window in direction</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Space</span><span foreground='#ffffff'> - Toggle between tiling/floating focus</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Shift + Space</span><span foreground='#ffffff'> - Toggle focused window tiling ↔ floating</span>

<span font='Iosevka Nerd Font 9' foreground='#b8bb26'><b>Layout</b></span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + b</span><span foreground='#ffffff'> - Split layout: horizontal</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + v</span><span foreground='#ffffff'> - Split layout: vertical</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + s</span><span foreground='#ffffff'> - Layout: stacking</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + w</span><span foreground='#ffffff'> - Layout: tabbed</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + e</span><span foreground='#ffffff'> - Toggle layout split (horizontal/vertical)</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + f</span><span foreground='#ffffff'> - Toggle fullscreen</span>

<span font='Iosevka Nerd Font 9' foreground='#b8bb26'><b>Workspaces</b></span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + [1-10]</span><span foreground='#ffffff'> - Switch to workspace 1–10</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Shift + [1-10]</span><span foreground='#ffffff'> - Move focused window to workspace 1–10</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + Tab</span><span foreground='#ffffff'> - Cycle workspaces (custom, not default)</span>

<span font='Iosevka Nerd Font 9' foreground='#b8bb26'><b>Resizing (Resize Mode)</b></span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>$mod + r</span><span foreground='#ffffff'> - Enter resize mode</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>(In resize mode): $left / $down / $up / $right</span><span foreground='#ffffff'> - Shrink/grow window</span>
<span font='Iosevka Nerd Font 9' foreground='#fb4934'>Return / Escape</span><span foreground='#ffffff'> - Exit resize mode</span>
